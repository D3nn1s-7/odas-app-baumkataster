{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "odas-app-baumkataster",
  "title": "Baumkataster",
  "fields": [
    {
      "name": "geo_point_2d",
      "title": "Standort (lat, lon)",
      "type": "string",
      "description": "Standort als Text „Breite, Länge\" in Dezimalgrad (wird von der App zerlegt).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "art_botani",
      "title": "Art (botanisch)",
      "type": "string",
      "description": "Botanischer Artname, z. B. FAGUS SPEC.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "art_deutsc",
      "title": "Art (deutsch)",
      "type": "string",
      "description": "Deutscher Artname, z. B. BUCHE.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "pflanzjahr",
      "title": "Pflanzjahr",
      "type": "integer",
      "description": "Jahr der Pflanzung als ganze Zahl.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "standalter",
      "title": "Standalter (Jahre)",
